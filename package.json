{
  "name": "memory-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MEMORY LAB — animated Medical Laboratory Science reviewer (MLS(ASCP)/ASCPi and Philippine MTLE tracks)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "e2e": "node e2e/verify.mjs",
    "check": "npm run validate && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
