      "stem": "A collection yields 1.2 × 10⁶ CD34⁺ cells/kg for an autologous transplant. What is the best interpretation?",
      "options": [
        {
          "id": "a",
          "text": "Below the commonly cited minimum (≥ 2 × 10⁶/kg); collect more or remobilize",
          "rationale": "Correct. Too low a dose risks failed or delayed engraftment."
        },
        {
          "id": "b",
          "text": "Adequate — any CD34⁺ count above zero engrafts",
          "rationale": "Incorrect. A minimum dose is required."
        },
        {
          "id": "c",
          "text": "Adequate if the total nucleated cell count is high",
          "rationale": "Incorrect. Adequacy is judged by CD34⁺ cells per kg."
        },
        {
          "id": "d",
          "text": "Excessive — discard part of the product",
          "rationale": "Incorrect. The dose is below, not above, the minimum."
        }
      ],
