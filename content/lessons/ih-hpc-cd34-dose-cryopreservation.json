      "stem": "An apheresis product contains 3.5 × 10⁸ CD34⁺ cells for a 70-kg patient. What is the CD34⁺ dose?",
      "options": [
        {
          "id": "a",
          "text": "5.0 × 10⁶ CD34⁺ cells/kg",
          "rationale": "Correct. 3.5 × 10⁸ ÷ 70 = 5.0 × 10⁶ per kg."
        },
        {
          "id": "b",
          "text": "5.0 × 10⁸ CD34⁺ cells/kg",
          "rationale": "Incorrect. Dividing by 70 lowers the exponent: 3.5 × 10⁸ ÷ 70 = 5.0 × 10⁶."
        },
        {
          "id": "c",
          "text": "2.45 × 10¹⁰ CD34⁺ cells/kg",
          "rationale": "Incorrect. That multiplies by weight instead of dividing."
        },
        {
          "id": "d",
          "text": "0.5 × 10⁶ CD34⁺ cells/kg",
          "rationale": "Incorrect. A factor-of-10 slip."
        }
