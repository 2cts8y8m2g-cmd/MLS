    {
      "id": "lab",
      "kind": "lab",
      "title": "In the lab: freezing the product",
      "start": 100,
      "end": 140,
      "altText": "Cryopreservation steps light up: add the cryoprotectant DMSO (commonly 10%) to protect cells from ice damage; freeze slowly in a controlled-rate freezer (about 1–2 °C per minute for hematopoietic cells); store in liquid or vapour-phase liquid nitrogen; thaw rapidly at the bedside. A caution token: DMSO itself is toxic to cells at high concentrations, so exposure is kept short.",
      "cues": [
        {
          "id": "l1",
          "start": 100,
          "end": 110,
          "text": "The product is frozen until the patient has received high-dose chemotherapy. First, a cryoprotectant is added — usually dimethyl sulfoxide, DMSO, commonly at 10 percent."
        },
        {
          "id": "l2",
          "start": 110,
          "end": 120,
          "text": "DMSO lets water move out of the cells so damaging ice crystals don’t form inside them. But at high concentrations it is toxic to cells, so exposure is kept short."
        },
        {
          "id": "l3",
          "start": 120,
          "end": 130,
          "text": "Hematopoietic cells are frozen slowly, at about one to two degrees per minute in a controlled-rate freezer, then stored in liquid or vapour-phase nitrogen."
        },
        {
          "id": "l4",
          "start": 130,
          "end": 140,
          "text": "When it’s time, the product is thawed rapidly and infused."
        }
      ],
