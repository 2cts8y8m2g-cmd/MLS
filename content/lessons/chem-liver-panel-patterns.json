      "id": "chem-liv-q1",
      "stem": "ALT is 400 U/L (ULN 40) and ALP 150 U/L (ULN 120). What injury pattern is suggested?",
      "options": [
        {
          "id": "a",
          "text": "Hepatocellular (R = 8)",
          "rationale": "Correct. (400/40) ÷ (150/120) = 10 ÷ 1.25 = 8, which is > 5."
        },
        {
          "id": "b",
          "text": "Cholestatic",
          "rationale": "Incorrect. Cholestatic requires R < 2."
        },
        {
          "id": "c",
          "text": "Mixed",
          "rationale": "Incorrect. Mixed is R 2–5."
        },
        {
          "id": "d",
          "text": "Normal",
          "rationale": "Incorrect. ALT is 10 × ULN."
        }
      ],
      "answer": "a",
      "skill": "R value",
      "difficulty": "application"
    },
    {
      "id": "chem-liv-q2",
      "stem": "A 14-year-old in a growth spurt has a raised ALP with normal GGT, bilirubin and ALT. Most likely source?",
      "options": [
        {
          "id": "a",
          "text": "Bone",
          "rationale": "Correct. Normal GGT argues against a hepatobiliary source; bone ALP rises with growth."
        },
        {
          "id": "b",
          "text": "Biliary obstruction",
          "rationale": "Incorrect. GGT would usually be raised."
        },
        {
          "id": "c",
          "text": "Hepatocellular injury",
          "rationale": "Incorrect. ALT is normal."
        },
        {
          "id": "d",
          "text": "Delta-bilirubin",
          "rationale": "Incorrect. Delta-bilirubin is a bilirubin fraction, not an ALP source."
        }
      ],
      "answer": "a",
      "skill": "ALP source",
      "difficulty": "application"
    },
    {
      "id": "chem-liv-q3",
      "stem": "Four weeks after acute hepatitis, ALT is normal, direct bilirubin remains elevated but falling, and urine bilirubin is negative. Best explanation?",
      "options": [
        {
          "id": "a",
          "text": "Delta-bilirubin — albumin-bound, long half-life, not filtered",
          "rationale": "Correct. It is measured as direct bilirubin and clears with albumin’s 17–21-day half-life."
        },
        {
          "id": "b",
          "text": "Ongoing biliary obstruction",
          "rationale": "Incorrect. Obstruction usually causes bilirubinuria and raised ALP/GGT."
        },
        {
          "id": "c",
          "text": "Hemolysis",
          "rationale": "Incorrect. Hemolysis raises unconjugated (indirect) bilirubin."
        },
        {
          "id": "d",
          "text": "Laboratory error",
          "rationale": "Incorrect. This is a recognised physiological pattern."
        }
      ],
      "answer": "a",
      "skill": "Delta-bilirubin",
      "difficulty": "application"
    }
