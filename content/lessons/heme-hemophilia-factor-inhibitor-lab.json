    {
      "id": "exam",
      "kind": "exam",
      "title": "Three classic traps",
      "start": 144,
      "end": 174,
      "altText": "Trap card: “Normal APTT and high one-stage FVIII on emicizumab = no problem” is crossed out → “Emicizumab fakes both — use a bovine chromogenic FVIII assay.” Trap card: “Mild hemophilia means < 30% factor” is crossed out → “Mild is > 5–40 IU/dL.” Trap card: “A residual of 5% after mixing gives a precise BU titer” is crossed out → “Only 25–75% residual is valid; dilute and repeat.”",
      "cues": [
        {
          "id": "e1",
          "start": 144,
          "end": 154,
