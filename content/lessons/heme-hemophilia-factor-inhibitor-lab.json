  "questions": [
    {
      "id": "heme-hemo-lab-q1",
      "stem": "In a Nijmegen–Bethesda assay, an undiluted patient sample leaves 50% residual FVIII activity compared with the control. What is the inhibitor titre?",
      "options": [
        {
          "id": "a",
          "text": "1 BU/mL",
          "rationale": "Correct. One Bethesda unit is the inhibitor amount that destroys 50% of FVIII."
        },
        {
          "id": "b",
          "text": "0.5 BU/mL",
          "rationale": "Incorrect. 0.5 BU would leave more than 50% residual."
        },
        {
          "id": "c",
          "text": "2 BU/mL",
          "rationale": "Incorrect. 2 BU/mL leaves 25% residual."
        },
        {
          "id": "d",
          "text": "50 BU/mL",
          "rationale": "Incorrect. Residual percentage is not the titre."
        }
      ],
      "answer": "a",
      "skill": "Bethesda units",
      "difficulty": "application"
    },
    {
      "id": "heme-hemo-lab-q2",
      "stem": "A man has FVIII activity of 18 IU/dL and bled excessively only after a tooth extraction. How is his hemophilia classified?",
      "options": [
        {
          "id": "a",
          "text": "Mild",
          "rationale": "Correct. Mild hemophilia is > 5–40 IU/dL with bleeding mainly after trauma or surgery."
        },
        {
          "id": "b",
          "text": "Moderate",
          "rationale": "Incorrect. Moderate is 1–5 IU/dL."
        },
        {
          "id": "c",
          "text": "Severe",
          "rationale": "Incorrect. Severe is < 1 IU/dL."
        },
        {
          "id": "d",
          "text": "Normal; not hemophilia",
          "rationale": "Incorrect. 18 IU/dL is well below normal and within the mild range."
        }
      ],
      "answer": "a",
      "skill": "Severity grading",
      "difficulty": "application"
    },
    {
      "id": "heme-hemo-lab-q3",
      "stem": "A patient on emicizumab prophylaxis needs FVIII activity measured after a FVIII infusion. Which assay should be used?",
      "options": [
        {
          "id": "a",
          "text": "Chromogenic FVIII assay with bovine reagents",
          "rationale": "Correct. Bovine reagents are not recognised by emicizumab, so the assay measures true FVIII."
        },
        {
          "id": "b",
          "text": "APTT-based one-stage FVIII assay",
          "rationale": "Incorrect. Emicizumab falsely raises APTT-based results."
        },
        {
          "id": "c",
          "text": "Chromogenic assay with human FIXa and FX",
          "rationale": "Incorrect. Human-reagent chromogenic assays detect emicizumab."
        },
        {
          "id": "d",
          "text": "Plain APTT",
          "rationale": "Incorrect. Emicizumab shortens the APTT."
        }
      ],
      "answer": "a",
      "skill": "Emicizumab interference",
      "difficulty": "application"
    }
