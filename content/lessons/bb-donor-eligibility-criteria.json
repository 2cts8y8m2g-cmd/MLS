    {
      "id": "change",
      "kind": "change",
      "title": "What changes: the numbers that decide",
      "start": 60,
      "end": 104,
      "altText": "A table builds: Temperature ≤ 37.5 °C (99.5 °F). Blood pressure: systolic 90–180, diastolic 50–100 mmHg (outside → only if the responsible physician examines and approves). Pulse: regular, 50–100/min (same physician exception). Weight ≥ 50 kg (110 lb). Hemoglobin/hematocrit: female allogeneic ≥ 12.5 g/dL or Hct ≥ 38%; male allogeneic ≥ 13.0 g/dL or Hct ≥ 39%; autologous ≥ 11.0 g/dL or Hct ≥ 33%.",
      "cues": [
        {
          "id": "c1",
          "start": 60,
          "end": 69,
          "text": "Temperature must not exceed thirty-seven point five degrees Celsius. Weight must be at least fifty kilograms — a hundred and ten pounds."
        },
        {
          "id": "c2",
          "start": 69,
          "end": 80,
          "text": "Blood pressure must be between ninety and one-eighty systolic, and fifty and one hundred diastolic. The pulse must be regular, fifty to one hundred. Outside those limits, only the responsible physician can approve donation after examining the donor."
        },
        {
          "id": "c3",
          "start": 80,
          "end": 92,
          "text": "Hemoglobin differs by sex. Female allogeneic donors need at least twelve point five grams per decilitre, or a hematocrit of thirty-eight percent. Male allogeneic donors need at least thirteen point zero, or thirty-nine percent."
        },
        {
          "id": "c4",
          "start": 92,
          "end": 104,
          "text": "Autologous donors — giving blood for themselves — may donate with hemoglobin as low as eleven point zero, or a hematocrit of thirty-three percent."
        }
      ],
