    {
      "id": "lab",
      "kind": "lab",
      "title": "In the lab: sampling, exceptions and intervals",
      "start": 104,
      "end": 144,
      "altText": "Card 1: hemoglobin is measured on fingerstick or venous blood (or an equivalent method) — earlobe blood is not acceptable. Card 2: female donors with Hb 12.0–12.5 g/dL (Hct 36–38%) may donate only under a procedure FDA has found acceptable. Card 3: donation interval — one unit of whole blood (or one unit of apheresis red cells) no more than once in 8 weeks; two-unit apheresis red cells no more than once in 16 weeks (exceptions such as autologous use need physician examination). Card 4: proof of identity and a postal address for contact for 8 weeks after donation.",
      "cues": [
        {
          "id": "l1",
          "start": 104,
          "end": 114,
          "text": "The hemoglobin sample can come from a fingerstick, a vein, or an equivalent method — but not the earlobe."
        },
        {
          "id": "l2",
          "start": 114,
          "end": 123,
          "text": "A female donor between twelve and twelve point five may donate only if the collector follows a procedure the FDA has found acceptable for protecting her health."
        },
        {
          "id": "l3",
          "start": 123,
          "end": 135,
          "text": "Intervals: one unit of whole blood no more than once every eight weeks; a double red-cell apheresis donation no more than once every sixteen weeks — unless a physician examines the donor for an exception, such as autologous use."
        },
        {
          "id": "l4",
          "start": 135,
          "end": 144,
          "text": "And every donor gives proof of identity and a postal address, so they can be contacted for eight weeks after donating."
        }
      ],
