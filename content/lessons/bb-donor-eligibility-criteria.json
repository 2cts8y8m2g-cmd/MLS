  "questions": [
    {
      "id": "bb-donor-q1",
      "stem": "A male allogeneic whole-blood donor has Hb 12.7 g/dL on fingerstick. What is the correct action under US FDA rules?",
      "options": [
        {
          "id": "a",
          "text": "Defer — male allogeneic donors need ≥ 13.0 g/dL",
          "rationale": "Correct. 21 CFR 630.10 sets 13.0 g/dL (Hct 39%) for male allogeneic donors."
        },
        {
          "id": "b",
          "text": "Accept — 12.5 g/dL is the minimum for all donors",
          "rationale": "Incorrect. 12.5 g/dL applies to female allogeneic donors."
        },
        {
          "id": "c",
          "text": "Accept as an autologous donor",
          "rationale": "Incorrect. Autologous rules apply only to donation for the donor’s own use."
        },
        {
          "id": "d",
          "text": "Repeat on an earlobe sample",
          "rationale": "Incorrect. Earlobe blood is not acceptable."
        }
      ],
      "answer": "a",
      "skill": "Donor hemoglobin",
      "difficulty": "application"
    },
    {
      "id": "bb-donor-q2",
      "stem": "A donor has temperature 37.3 °C, BP 172/96 mmHg, regular pulse 104/min, weight 62 kg and Hb 13.4 g/dL. Which finding prevents routine donation?",
      "options": [
        {
          "id": "a",
          "text": "Pulse 104/min",
          "rationale": "Correct. Pulse must be regular and 50–100/min unless the responsible physician examines and approves."
        },
        {
          "id": "b",
          "text": "Temperature 37.3 °C",
          "rationale": "Incorrect. The limit is ≤ 37.5 °C."
        },
        {
          "id": "c",
          "text": "BP 172/96 mmHg",
          "rationale": "Incorrect. Limits are systolic ≤ 180 and diastolic ≤ 100."
        },
        {
          "id": "d",
          "text": "Weight 62 kg",
          "rationale": "Incorrect. The minimum is 50 kg."
        }
      ],
      "answer": "a",
      "skill": "Donor vital signs",
      "difficulty": "application"
    },
    {
      "id": "bb-donor-q3",
      "stem": "A donor gave a two-unit red-cell apheresis donation 10 weeks ago. When may they next donate red cells routinely?",
      "options": [
        {
          "id": "a",
          "text": "After 16 weeks from the last donation",
          "rationale": "Correct. Two-unit RBC apheresis is limited to once in 16 weeks."
        },
        {
          "id": "b",
          "text": "Now — 8 weeks have passed",
          "rationale": "Incorrect. The 8-week interval applies to single units."
        },
        {
          "id": "c",
          "text": "After 12 months",
          "rationale": "Incorrect. The regulation sets 16 weeks."
        },
        {
          "id": "d",
          "text": "Any time if Hb ≥ 13.0 g/dL",
          "rationale": "Incorrect. Hb does not override the interval."
        }
      ],
      "answer": "a",
      "skill": "Donation intervals",
      "difficulty": "application"
    }
